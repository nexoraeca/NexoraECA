# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL DELIVERY CONFIGURATION:
# 1. Google Firebase Free Email Service: Active by default! 100% Free, no SendGrid API key or setup needed.
# 2. Resend Free API (Optional, 3,000 free emails/month): https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# 3. Brevo Free API (Optional, 300 free emails/day): https://brevo.com
BREVO_API_KEY=""

# 4. SendGrid API (Optional):
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@educonnectindia.in"
